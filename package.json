{
  "name": "@qz/agent-kit",
  "version": "0.1.7",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "qz-kit": "bin/qz-kit",
    "qz": "bin/qz"
  },
  "description": "Fuente de verdad y adapters para workflows de agentes CLI.",
  "scripts": {
    "manifest": "node scripts/generate-manifests.mjs",
    "render": "node scripts/render.mjs",
    "validate:project": "node scripts/validate-project.mjs fixtures/generic-project",
    "plan:backup": "node scripts/backup-plan.mjs",
    "check": "npm run validate:project && node scripts/validate-adapters.mjs && node scripts/check-manifests.mjs",
    "test": "node scripts/smoke.mjs",
    "release:check": "node scripts/release-check.mjs",
    "check:package": "node scripts/check-package.mjs && node scripts/validate-adapters.mjs",
    "memory:scan": "node scripts/qz-memory.mjs scan --json",
    "install:clients": "node scripts/install.mjs --plan"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1"
  }
}
