#!/usr/bin/env node
import { existsSync, readFileSync } from 'node:fs'
import { dirname, join, resolve } from 'node:path'
import { homedir } from 'node:os'
import { spawnSync } from 'node:child_process'

const args = process.argv.slice(2)
const command = args.shift() || 'help'
if (command === '--version' || command === 'version') {
  console.log('qz dispatcher 1')
  process.exit(0)
}
if (command === 'engram') {
  const installedWrapper = join(homedir(), '.config/qz-agent-kit/bin/qz-engram.mjs')
  const wrapper = existsSync(installedWrapper) ? installedWrapper : resolve(new URL('../scripts/qz-engram.mjs', import.meta.url).pathname)
  const result = spawnSync(process.execPath, [wrapper, ...args], { stdio: 'inherit', shell: false })
  process.exit(result.status ?? 1)
}
const findRoot = (start) => {
  let current = resolve(start)
  while (true) {
    if (existsSync(join(current, '.qz/project.json'))) return current
    const parent = dirname(current)
    if (parent === current) return null
    current = parent
  }
}
const root = findRoot(process.cwd())
if (!root) {
  console.error('qz: no encontré .qz/project.json en este directorio ni sus padres')
  process.exit(1)
}
const manifestPath = join(root, '.qz/project.json')
const config = JSON.parse(readFileSync(manifestPath, 'utf8'))
const sensitive = /(?:secret|token|password|passwd|private.?key|credential|cookie|auth)/i
const sanitize = (value, key = '') => {
  if (sensitive.test(key)) return undefined
  if (Array.isArray(value)) return value.map((item) => sanitize(item)).filter((item) => item !== undefined)
  if (value && typeof value === 'object') {
    return Object.fromEntries(Object.entries(value).flatMap(([childKey, childValue]) => {
      const safe = sanitize(childValue, childKey)
      return safe === undefined ? [] : [[childKey, safe]]
    }))
  }
  return value
}

if (command === 'help' || command === '--help') {
  console.log(`qz — dispatcher portable del adapter ${config.adapter || '(sin adapter)'}

Uso:
  qz engram <operación>    consulta read-only de Engram, incluso fuera de un proyecto
  qz doctor                 valida el contrato del proyecto
  qz config [--json]        muestra configuración no secreta
  qz <comando> [args...]    delega en el adapter declarado

El dispatcher no implementa Linear, Git, worktrees, env, DB ni servidores.`)
  process.exit(0)
}
if (command === 'config') {
  const safe = sanitize(config)
  if (args.includes('--json')) console.log(JSON.stringify({ projectRoot: root, manifest: manifestPath, config: safe, secretValues: 'not-read' }, null, 2))
  else console.log(`${safe.projectId || '(sin id)'} · adapter=${safe.adapter || '(sin adapter)'} · base=${safe.branches?.base || '(sin base)'}`)
  process.exit(0)
}
if (command === 'doctor') {
  const validator = resolve(new URL('../scripts/validate-project.mjs', import.meta.url).pathname)
  const result = spawnSync(process.execPath, [validator, root], { stdio: 'inherit' })
  process.exit(result.status ?? 1)
}

const dispatch = config.commands?.dispatch
if (typeof dispatch !== 'string' || dispatch.length === 0) {
  if (command === 'start-issue' || command === 'close-issue') {
    const fallback = join(homedir(), '.config/qz-agent-kit/bin', command === 'start-issue' ? 'generic-start-issue.mjs' : 'generic-close-issue.mjs')
    if (existsSync(fallback)) {
      const result = spawnSync(process.execPath, [fallback, '--root', root, ...args], { cwd: root, stdio: 'inherit' })
      process.exit(result.status ?? 1)
    }
  }
  console.error(`qz: el adapter "${config.adapter || '(sin adapter)'}" no declara commands.dispatch`)
  console.error('qz: este comando requiere soporte del adapter o el fallback genérico disponible')
  process.exit(2)
}
const result = spawnSync(dispatch, [command, ...args], { cwd: root, stdio: 'inherit', shell: true })
if ((command === 'start-issue' || command === 'close-issue') && result.status === 2) {
  const fallback = join(homedir(), '.config/qz-agent-kit/bin', command === 'start-issue' ? 'generic-start-issue.mjs' : 'generic-close-issue.mjs')
  if (existsSync(fallback)) {
    const generic = spawnSync(process.execPath, [fallback, '--root', root, ...args], { cwd: root, stdio: 'inherit' })
    process.exit(generic.status ?? 1)
  }
}
process.exit(result.status ?? 1)
