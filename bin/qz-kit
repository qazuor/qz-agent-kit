#!/usr/bin/env node
import { spawnSync } from 'node:child_process'
import { existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs'
import { homedir } from 'node:os'
import { dirname, join, resolve } from 'node:path'
import { assertValidPlan } from '../scripts/plan-schema.mjs'

const rawArgs = process.argv.slice(2)
const packageRoot = resolve(new URL('..', import.meta.url).pathname)
if (rawArgs.length === 0) {
  const menu = resolve(packageRoot, 'scripts/kit-menu.mjs')
  const result = spawnSync(process.execPath, [menu], { stdio: 'inherit' })
  process.exit(result.status ?? 1)
}
const [command, ...args] = rawArgs
const packageJson = JSON.parse(readFileSync(join(dirname(new URL(import.meta.url).pathname), '..', 'package.json'), 'utf8'))
if (command === '--version' || command === 'version') {
  console.log(`${packageJson.name} ${packageJson.version}`)
  process.exit(0)
}
const script = resolve(packageRoot, 'scripts/install.mjs')
const rollback = resolve(new URL('..', import.meta.url).pathname, 'scripts/rollback.mjs')
const projects = resolve(new URL('..', import.meta.url).pathname, 'scripts/projects.mjs')
const doctor = resolve(new URL('..', import.meta.url).pathname, 'scripts/doctor.mjs')
const wizard = resolve(new URL('..', import.meta.url).pathname, 'scripts/install-wizard.mjs')
const ecosystem = resolve(new URL('..', import.meta.url).pathname, 'scripts/ecosystem.mjs')
const preflight = resolve(new URL('..', import.meta.url).pathname, 'scripts/preflight.mjs')
const backupPlan = resolve(new URL('..', import.meta.url).pathname, 'scripts/backup-plan.mjs')
const externalPlan = resolve(new URL('..', import.meta.url).pathname, 'scripts/external-plan.mjs')
const externalPreview = resolve(new URL('..', import.meta.url).pathname, 'scripts/external-preview.mjs')
const externalReceipt = resolve(new URL('..', import.meta.url).pathname, 'scripts/external-receipt.mjs')
const externalBackupStatus = resolve(new URL('..', import.meta.url).pathname, 'scripts/external-backup-status.mjs')
const externalBackup = resolve(new URL('..', import.meta.url).pathname, 'scripts/external-backup.mjs')
const externalApply = resolve(new URL('..', import.meta.url).pathname, 'scripts/external-apply.mjs')
const provenance = resolve(new URL('..', import.meta.url).pathname, 'scripts/provenance-check.mjs')
const readiness = resolve(new URL('..', import.meta.url).pathname, 'scripts/readiness.mjs')
const planScript = resolve(new URL('..', import.meta.url).pathname, 'scripts/plan.mjs')
const subscriptionValidate = resolve(new URL('..', import.meta.url).pathname, 'scripts/subscription-validate.mjs')
const subscriptionServer = resolve(new URL('..', import.meta.url).pathname, 'scripts/subscription-server.mjs')
const subscriptionRefresh = resolve(new URL('..', import.meta.url).pathname, 'scripts/subscription-refresh.mjs')
const subscriptionService = resolve(new URL('..', import.meta.url).pathname, 'scripts/subscription-service.mjs')
const subscriptionTray = resolve(new URL('..', import.meta.url).pathname, 'scripts/subscription-tray.py')
const memory = resolve(new URL('..', import.meta.url).pathname, 'scripts/qz-memory.mjs')
const argValue = (flag) => { const i = args.indexOf(flag); return i >= 0 ? args[i + 1] : undefined }
if (command === 'project') {
  const result = spawnSync(process.execPath, [projects, ...args], { stdio: 'inherit' })
  process.exit(result.status ?? 1)
}
if (command === 'rollback') {
  const result = spawnSync(process.execPath, [rollback, ...args], { stdio: 'inherit' })
  process.exit(result.status ?? 1)
}
if (command === 'doctor') {
  const result = spawnSync(process.execPath, [doctor, ...args], { stdio: 'inherit' })
  process.exit(result.status ?? 1)
}
if (command === 'ecosystem' || command === 'ecosystem-check') {
  const result = spawnSync(process.execPath, [ecosystem, ...args], { stdio: 'inherit' })
  process.exit(result.status ?? 1)
}
if (command === 'preflight') {
  const result = spawnSync(process.execPath, [preflight, ...args], { stdio: 'inherit' })
  process.exit(result.status ?? 1)
}
if (command === 'backup-plan') {
  const result = spawnSync(process.execPath, [backupPlan, ...args], { stdio: 'inherit' })
  process.exit(result.status ?? 1)
}
if (command === 'external-plan') {
  const result = spawnSync(process.execPath, [externalPlan, ...args], { stdio: 'inherit' })
  process.exit(result.status ?? 1)
}
if (command === 'external-preview') {
  const result = spawnSync(process.execPath, [externalPreview, ...args], { stdio: 'inherit' })
  process.exit(result.status ?? 1)
}
if (command === 'external-receipt') {
  const result = spawnSync(process.execPath, [externalReceipt, ...args], { stdio: 'inherit' })
  process.exit(result.status ?? 1)
}
if (command === 'external-backup-status') {
  const result = spawnSync(process.execPath, [externalBackupStatus, ...args], { stdio: 'inherit' })
  process.exit(result.status ?? 1)
}
if (command === 'external-backup') {
  const result = spawnSync(process.execPath, [externalBackup, ...args], { stdio: 'inherit' })
  process.exit(result.status ?? 1)
}
if (command === 'external-apply') {
  const result = spawnSync(process.execPath, [externalApply, ...args], { stdio: 'inherit' })
  process.exit(result.status ?? 1)
}
if (command === 'provenance') {
  const result = spawnSync(process.execPath, [provenance, ...args], { stdio: 'inherit' })
  process.exit(result.status ?? 1)
}
if (command === 'memory') {
  const result = spawnSync(process.execPath, [memory, ...args], { stdio: 'inherit' })
  process.exit(result.status ?? 1)
}
if (command === 'readiness') {
  const result = spawnSync(process.execPath, [readiness, ...args], { stdio: 'inherit' })
  process.exit(result.status ?? 1)
}
if (command === 'plan') {
  const result = spawnSync(process.execPath, [planScript, ...args], { stdio: 'inherit' })
  process.exit(result.status ?? 1)
}
if (command === 'subscriptions' && args[0] === 'validate') {
  const result = spawnSync(process.execPath, [subscriptionValidate, ...args.slice(1)], { stdio: 'inherit' })
  process.exit(result.status ?? 1)
}
if (command === 'subscriptions' && args[0] === 'serve') {
  const result = spawnSync(process.execPath, [subscriptionServer, ...args.slice(1)], { stdio: 'inherit' })
  process.exit(result.status ?? 1)
}
if (command === 'subscriptions' && args[0] === 'refresh') {
  const result = spawnSync(process.execPath, [subscriptionRefresh, ...args.slice(1)], { stdio: 'inherit' })
  process.exit(result.status ?? 1)
}
if (command === 'subscriptions' && args[0] === 'install') {
  const result = spawnSync(process.execPath, [subscriptionService, ...args.slice(1)], { stdio: 'inherit' })
  process.exit(result.status ?? 1)
}
if (command === 'subscriptions' && args[0] === 'tray') {
  const trayArgs = args.slice(1)
  const trayVenv = join(homedir(), '.local/share/qz-agent-kit/tray-venv')
  const trayPython = process.env.QZ_TRAY_PYTHON || join(trayVenv, 'bin/python')
  const noInstall = trayArgs.includes('--no-install')
  const ensureTrayRuntime = () => {
    if (noInstall || process.env.QZ_TRAY_PYTHON) return true
    const bootstrapPython = process.env.QZ_TRAY_BOOTSTRAP_PYTHON || 'python3'
    console.error('qz usage tray: preparando entorno aislado y PySide6…')
    let venv = existsSync(trayPython)
      ? { status: 0 }
      : spawnSync(bootstrapPython, ['-m', 'venv', trayVenv], { stdio: 'inherit' })
    if (venv.status !== 0 && process.platform === 'linux' && spawnSync('command', ['-v', 'apt-get'], { shell: true, stdio: 'ignore' }).status === 0) {
      console.error('Falta python3-venv; se solicitará sudo para instalarlo.')
      const apt = spawnSync('sudo', ['apt-get', 'install', '-y', 'python3-venv'], { stdio: 'inherit' })
      if (apt.status === 0) venv = spawnSync(bootstrapPython, ['-m', 'venv', trayVenv], { stdio: 'inherit' })
    }
    if (venv.status !== 0) {
      console.error('No se pudo crear el entorno Python. Instala python3-venv o define QZ_TRAY_BOOTSTRAP_PYTHON.')
      return false
    }
    const moduleProbe = spawnSync(trayPython, ['-c', 'import PySide6'], { stdio: 'ignore' })
    if (moduleProbe.status === 0) return true
    const install = spawnSync(trayPython, ['-m', 'pip', 'install', '--disable-pip-version-check', 'PySide6>=6.8,<7'], { stdio: 'inherit' })
    if (install.status !== 0) {
      console.error('No se pudo instalar PySide6 en el entorno aislado del kit.')
      return false
    }
    return true
  }
  if (trayArgs[0] === 'install') {
    const unitPath = join(homedir(), '.config/systemd/user/qz-subscriptions-tray.service')
    const unit = `[Unit]\nDescription=qz subscription tray\nAfter=qz-subscriptions.service graphical-session.target\n\n[Service]\nType=simple\nExecStart=${trayPython} ${subscriptionTray}\nRestart=on-failure\nRestartSec=5\nNoNewPrivileges=true\n\n[Install]\nWantedBy=default.target\n`
    if (trayArgs.includes('--plan')) {
      console.log(JSON.stringify({ unitPath, unit, mutations: 'none', secretValues: 'not-read' }, null, 2))
      process.exit(0)
    }
    if (!ensureTrayRuntime()) process.exit(1)
    const probe = spawnSync('systemctl', ['--user', 'show-environment'], { stdio: 'ignore' })
    if (probe.status !== 0) { console.error('systemd --user no está disponible.'); process.exit(1) }
    mkdirSync(join(homedir(), '.config/systemd/user'), { recursive: true })
    writeFileSync(unitPath, unit, { mode: 0o600 })
    if (spawnSync('systemctl', ['--user', 'daemon-reload'], { stdio: 'inherit' }).status !== 0) process.exit(1)
    if (spawnSync('systemctl', ['--user', 'enable', '--now', 'qz-subscriptions-tray.service'], { stdio: 'inherit' }).status !== 0) process.exit(1)
    console.log(JSON.stringify({ unitPath, status: 'installed', mutations: [unitPath, 'systemd-user-unit'], secretValues: 'not-read' }, null, 2))
    process.exit(0)
  }
  if (!ensureTrayRuntime()) process.exit(1)
  const result = spawnSync(existsSync(trayPython) ? trayPython : 'python3', [subscriptionTray, ...trayArgs.filter((arg) => arg !== '--no-install')], { stdio: 'inherit' })
  process.exit(result.status ?? 1)
}
if (command === 'install' && (args.length === 0 || args.includes('--interactive') || args.includes('--from') || args.includes('--non-interactive'))) {
  const wizardArgs = args.filter((arg) => arg !== '--interactive')
  const result = spawnSync(process.execPath, [wizard, ...wizardArgs], { stdio: 'inherit' })
  process.exit(result.status ?? 1)
}
let updateArgs = args
if (command === 'update' && !args.includes('--client')) {
  const updateHome = resolve(argValue('--home') || homedir())
  const planPath = join(updateHome, '.config/qz-agent-kit/install-plan.json')
  if (existsSync(planPath)) {
    const plan = assertValidPlan(JSON.parse(readFileSync(planPath, 'utf8')))
    updateArgs = [...args, '--client', plan.clients.length ? plan.clients.join(',') : 'none']
  }
}
const mapped = command === 'update' ? (updateArgs.includes('--check') ? ['--check', ...updateArgs.filter((arg) => arg !== '--check')] : updateArgs.includes('--plan') ? ['--plan', ...updateArgs.filter((arg) => arg !== '--plan')] : ['--apply', ...updateArgs])
  : command === 'verify' ? ['--check', ...args]
    : command === 'install' ? args
      : []
if (!mapped.length && !['help', '--help', '-h'].includes(command)) {
  console.error('Uso: qz-kit install|update|plan|doctor|ecosystem|preflight|readiness|backup-plan|external-plan|external-preview|external-receipt|external-backup|external-backup-status|external-apply|subscriptions validate|subscriptions refresh|subscriptions serve|subscriptions install [--plan|--apply]|subscriptions tray|memory scan|memory plan|provenance|verify|rollback [opciones]')
  process.exit(2)
}
if (!mapped.length) {
  console.log('Uso: qz-kit install|update|plan|doctor|ecosystem|preflight|readiness|backup-plan|external-plan|external-preview|external-receipt|external-backup|external-backup-status|external-apply|subscriptions validate|subscriptions refresh|subscriptions serve|subscriptions install [--plan|--apply]|subscriptions tray|memory scan|memory plan|provenance|verify [opciones] | rollback <install-manifest.json>')
  process.exit(0)
}
const result = spawnSync(process.execPath, [script, ...mapped], { stdio: 'inherit' })
process.exit(result.status ?? 1)
