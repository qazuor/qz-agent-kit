#!/usr/bin/env node
import { spawnSync } from 'node:child_process'
import { existsSync, readFileSync } from 'node:fs'
import { homedir } from 'node:os'
import { dirname, join, resolve } from 'node:path'
import { assertValidPlan } from '../scripts/plan-schema.mjs'

const [command = 'help', ...args] = process.argv.slice(2)
const packageJson = JSON.parse(readFileSync(join(dirname(new URL(import.meta.url).pathname), '..', 'package.json'), 'utf8'))
if (command === '--version' || command === 'version') {
  console.log(`${packageJson.name} ${packageJson.version}`)
  process.exit(0)
}
const script = resolve(new URL('..', import.meta.url).pathname, 'scripts/install.mjs')
const rollback = resolve(new URL('..', import.meta.url).pathname, 'scripts/rollback.mjs')
const projects = resolve(new URL('..', import.meta.url).pathname, 'scripts/projects.mjs')
const doctor = resolve(new URL('..', import.meta.url).pathname, 'scripts/doctor.mjs')
const wizard = resolve(new URL('..', import.meta.url).pathname, 'scripts/install-wizard.mjs')
const ecosystem = resolve(new URL('..', import.meta.url).pathname, 'scripts/ecosystem.mjs')
const preflight = resolve(new URL('..', import.meta.url).pathname, 'scripts/preflight.mjs')
const backupPlan = resolve(new URL('..', import.meta.url).pathname, 'scripts/backup-plan.mjs')
const externalPlan = resolve(new URL('..', import.meta.url).pathname, 'scripts/external-plan.mjs')
const externalPreview = resolve(new URL('..', import.meta.url).pathname, 'scripts/external-preview.mjs')
const externalReceipt = resolve(new URL('..', import.meta.url).pathname, 'scripts/external-receipt.mjs')
const externalBackupStatus = resolve(new URL('..', import.meta.url).pathname, 'scripts/external-backup-status.mjs')
const provenance = resolve(new URL('..', import.meta.url).pathname, 'scripts/provenance-check.mjs')
const readiness = resolve(new URL('..', import.meta.url).pathname, 'scripts/readiness.mjs')
const planScript = resolve(new URL('..', import.meta.url).pathname, 'scripts/plan.mjs')
const argValue = (flag) => { const i = args.indexOf(flag); return i >= 0 ? args[i + 1] : undefined }
if (command === 'project') {
  const result = spawnSync(process.execPath, [projects, ...args], { stdio: 'inherit' })
  process.exit(result.status ?? 1)
}
if (command === 'rollback') {
  const result = spawnSync(process.execPath, [rollback, ...args], { stdio: 'inherit' })
  process.exit(result.status ?? 1)
}
if (command === 'doctor') {
  const result = spawnSync(process.execPath, [doctor, ...args], { stdio: 'inherit' })
  process.exit(result.status ?? 1)
}
if (command === 'ecosystem' || command === 'ecosystem-check') {
  const result = spawnSync(process.execPath, [ecosystem, ...args], { stdio: 'inherit' })
  process.exit(result.status ?? 1)
}
if (command === 'preflight') {
  const result = spawnSync(process.execPath, [preflight, ...args], { stdio: 'inherit' })
  process.exit(result.status ?? 1)
}
if (command === 'backup-plan') {
  const result = spawnSync(process.execPath, [backupPlan, ...args], { stdio: 'inherit' })
  process.exit(result.status ?? 1)
}
if (command === 'external-plan') {
  const result = spawnSync(process.execPath, [externalPlan, ...args], { stdio: 'inherit' })
  process.exit(result.status ?? 1)
}
if (command === 'external-preview') {
  const result = spawnSync(process.execPath, [externalPreview, ...args], { stdio: 'inherit' })
  process.exit(result.status ?? 1)
}
if (command === 'external-receipt') {
  const result = spawnSync(process.execPath, [externalReceipt, ...args], { stdio: 'inherit' })
  process.exit(result.status ?? 1)
}
if (command === 'external-backup-status') {
  const result = spawnSync(process.execPath, [externalBackupStatus, ...args], { stdio: 'inherit' })
  process.exit(result.status ?? 1)
}
if (command === 'provenance') {
  const result = spawnSync(process.execPath, [provenance, ...args], { stdio: 'inherit' })
  process.exit(result.status ?? 1)
}
if (command === 'readiness') {
  const result = spawnSync(process.execPath, [readiness, ...args], { stdio: 'inherit' })
  process.exit(result.status ?? 1)
}
if (command === 'plan') {
  const result = spawnSync(process.execPath, [planScript, ...args], { stdio: 'inherit' })
  process.exit(result.status ?? 1)
}
if (command === 'install' && (args.length === 0 || args.includes('--interactive') || args.includes('--from') || args.includes('--non-interactive'))) {
  const wizardArgs = args.filter((arg) => arg !== '--interactive')
  const result = spawnSync(process.execPath, [wizard, ...wizardArgs], { stdio: 'inherit' })
  process.exit(result.status ?? 1)
}
let updateArgs = args
if (command === 'update' && !args.includes('--client')) {
  const updateHome = resolve(argValue('--home') || homedir())
  const planPath = join(updateHome, '.config/qz-agent-kit/install-plan.json')
  if (existsSync(planPath)) {
    const plan = assertValidPlan(JSON.parse(readFileSync(planPath, 'utf8')))
    updateArgs = [...args, '--client', plan.clients.length ? plan.clients.join(',') : 'none']
  }
}
const mapped = command === 'update' ? (updateArgs.includes('--check') ? ['--check', ...updateArgs.filter((arg) => arg !== '--check')] : updateArgs.includes('--plan') ? ['--plan', ...updateArgs.filter((arg) => arg !== '--plan')] : ['--apply', ...updateArgs])
  : command === 'verify' ? ['--check', ...args]
    : command === 'install' ? args
      : []
if (!mapped.length && !['help', '--help', '-h'].includes(command)) {
  console.error('Uso: qz-kit install|update|plan|doctor|ecosystem|preflight|readiness|backup-plan|external-plan|external-preview|external-receipt|external-backup-status|provenance|verify|rollback [opciones]')
  process.exit(2)
}
if (!mapped.length) {
  console.log('Uso: qz-kit install|update|plan|doctor|ecosystem|preflight|readiness|backup-plan|external-plan|external-preview|external-receipt|external-backup-status|provenance|verify [opciones] | rollback <install-manifest.json>')
  process.exit(0)
}
const result = spawnSync(process.execPath, [script, ...mapped], { stdio: 'inherit' })
process.exit(result.status ?? 1)
