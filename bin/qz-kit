#!/usr/bin/env node
import { spawnSync } from 'node:child_process'
import { resolve } from 'node:path'

const [command = 'help', ...args] = process.argv.slice(2)
const script = resolve(new URL('..', import.meta.url).pathname, 'scripts/install.mjs')
const rollback = resolve(new URL('..', import.meta.url).pathname, 'scripts/rollback.mjs')
const projects = resolve(new URL('..', import.meta.url).pathname, 'scripts/projects.mjs')
if (command === 'project') {
  const result = spawnSync(process.execPath, [projects, ...args], { stdio: 'inherit' })
  process.exit(result.status ?? 1)
}
if (command === 'rollback') {
  const result = spawnSync(process.execPath, [rollback, ...args], { stdio: 'inherit' })
  process.exit(result.status ?? 1)
}
const mapped = command === 'update' ? ['--apply', ...args]
  : command === 'doctor' ? ['--check', ...args]
    : command === 'verify' ? ['--check', ...args]
    : command === 'install' ? args
      : []
if (!mapped.length && !['help', '--help', '-h'].includes(command)) {
  console.error('Uso: qz-kit install|update|doctor|verify|rollback [opciones]')
  process.exit(2)
}
if (!mapped.length) {
  console.log('Uso: qz-kit install|update|doctor|verify [--plan|--check|--apply] | rollback <install-manifest.json>')
  process.exit(0)
}
const result = spawnSync(process.execPath, [script, ...mapped], { stdio: 'inherit' })
process.exit(result.status ?? 1)
