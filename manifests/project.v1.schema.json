{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://qz.dev/schemas/project.v1.json",
  "type": "object",
  "required": ["schemaVersion", "projectId", "adapter", "issues", "branches", "worktree", "database", "servers", "commands"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "adapter": { "type": "string", "minLength": 1 },
    "displayName": { "type": "string" },
    "issues": { "type": "object", "required": ["provider", "teamKey"] },
    "branches": { "type": "object", "required": ["base", "protected"] },
    "worktree": { "type": "object", "required": ["pathPattern", "envSource"] },
    "database": { "type": "object" },
    "servers": { "type": "array", "minItems": 1 },
    "commands": {
      "type": "object",
      "required": ["genericPrefix", "projectPrefix"],
      "properties": {
        "dispatch": { "type": "string", "minLength": 1 },
        "registry": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "delegate", "description"],
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*-$|^[A-Za-z][A-Za-z0-9_-]*$" },
              "delegate": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "description": { "type": "string", "minLength": 1 },
              "mutates": { "type": "boolean" },
              "clients": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            },
            "additionalProperties": false
          }
        }
      }
    }
  },
  "additionalProperties": true
}
