{
  "schemaVersion": 1,
  "id": "engram",
  "displayName": "Engram",
  "detection": {
    "command": "engram",
    "versionArgs": ["version"]
  },
  "lifecycle": {
    "preview": ["doctor --json --check sqlite_lock_contention"],
    "readOnly": ["doctor", "stats", "projects list", "search", "context", "timeline", "conflicts list", "cloud status", "test --quick --json"],
    "dataExport": ["export", "obsidian-export"],
    "mutating": ["save", "delete", "import", "sync", "setup", "projects consolidate", "projects prune", "cloud enroll", "cloud config"],
    "requiresHumanApproval": true
  },
  "backupPolicy": {
    "database": "external-backup-required-before-any-mutation",
    "installer": "never-copies-or-modifies-db",
    "export": "never-implicit"
  },
  "apply": {
    "supported": false,
    "reason": "requiere backup SQLite consistente y restauración aislada verificable antes de automatizar cualquier mutación"
  },
  "installPlan": {
    "command": "engram setup opencode --protocol=full",
    "preview": "engram doctor --json --check sqlite_lock_contention --project <project>",
    "prerequisites": ["backup externo de ~/.engram", "check SQLite por proyecto", "decidir integración MCP", "confirmar protocolo full"]
  },
  "secrets": "never-read-or-copied",
  "source": "adapter-contract; exact versions resolved only during an explicit plan"
}
